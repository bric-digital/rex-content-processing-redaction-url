    "@bric/rex-types": "github:bric-digital/rex-types"
  },
  "devDependencies": {
    "@bric/rex-page-events": "github:bric-digital/rex-page-events",
    "@bric/rex-passive-data-kit": "github:bric-digital/rex-passive-data-kit",
    "@playwright/test": "1.65.0",
    "express": "^5.3.0"
  },
  "overrides": {
    "@bric/rex-content-processing": "$@bric/rex-content-processing",
    "@bric/rex-core": "$@bric/rex-core",
    "@bric/rex-lists": "$@bric/rex-lists",
